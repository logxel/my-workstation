# {{ ansible_managed | default('Managed by Ansible (roles/shell_config) -- local edits will be overwritten.') }}
# Workstation auto-clean: narrow sudo access for periodic cleanup tasks
# The journal vacuum goes through an argument-free root-owned wrapper because
# sudo-rs (default on Ubuntu 26.04) forbids wildcards in command arguments.
{{ local_user }} ALL=(root) NOPASSWD: /usr/local/sbin/workstation-journal-vacuum
{{ local_user }} ALL=(root) NOPASSWD: /usr/bin/flatpak uninstall --unused --noninteractive
