#!/usr/bin/env bash
# {{ ansible_managed | default('Managed by Ansible (roles/shell_config) — local edits will be overwritten.') }}
set -Eeuo pipefail

clean_old_files() {
  local target="$1"
  local age_days="$2"
  local dir
  local -a permission_changed=()

  if [[ ! -d "$target" ]]; then
    return 0
  fi

  # Do not follow a cache-root symlink or alter permissions outside the tree.
  if [[ -L "$target" ]]; then
    return 0
  fi

  # Some caches are deliberately immutable. The Go module cache ships 0555
  # directories and 0444 files, and unlink(2) needs write permission on the
  # PARENT directory -- so a bare `find -delete` fails with EACCES. Under
  # `set -Eeuo pipefail` that aborts this whole script, silently skipping every
  # cleanup below this call (uv/direnv/nix/docker/flatpak/journald). Add the
  # owner write bit temporarily to parent directories, then restore it on
  # directories that survive pruning; never follow symlinks.
  if [[ ! -w "$target" ]] && chmod u+w "$target" 2>/dev/null; then
    permission_changed+=("$target")
  fi
  while IFS= read -r -d '' dir; do
    if [[ ! -w "$dir" ]] && chmod u+w "$dir" 2>/dev/null; then
      permission_changed+=("$dir")
    fi
  done < <(find "$target" -mindepth 1 -type d -print0 2>/dev/null)

  find "$target" -mindepth 1 \( -type f -o -type l \) -mtime +"$age_days" -print -delete || true
  find "$target" -mindepth 1 -depth -type d -empty -mtime +"$age_days" -print -delete || true

  for dir in "${permission_changed[@]}"; do
    if [[ -d "$dir" && ! -L "$dir" ]]; then
      chmod u-w "$dir" 2>/dev/null || true
    fi
  done
}

run_if_available() {
  local binary="$1"
  shift

  if ! command -v "$binary" >/dev/null 2>&1; then
    return 0
  fi

  if ! "$@"; then
    printf 'Skipping failed cleanup command: %s\n' "$*" >&2
  fi
}

prune_vscode_cache() {
  local helper_image="{{ workstation_cleanup_vscode_cache_helper_image }}"
  local helper_script="$HOME/.local/bin/workstation-vscode-cache-prune.py"
  local running_containers running_container process_list active_commits commit config
  local -a protected_commits=()
{% for commit in workstation_cleanup_vscode_server_protected_commits %}
  protected_commits+=(--protect-commit {{ commit }})
{% endfor %}

  if ! docker volume inspect vscode >/dev/null 2>&1; then
    return 0
  fi

  if ! running_containers="$(docker ps --filter volume=vscode -q 2>/dev/null)"; then
    printf 'Skipping VS Code cache cleanup: could not check volume users.\n' >&2
    return 0
  fi
  # Preserve commits actually executing from the shared volume. A mounted
  # volume alone does not make unrelated, aged cache entries or old builds
  # active; the helper applies age/retention rules to those candidates.
  for running_container in $running_containers; do
    if ! process_list="$(docker top "$running_container" 2>/dev/null)"; then
      printf 'Skipping VS Code cache cleanup: could not inspect processes in %s.\n' \
        "$running_container" >&2
      return 0
    fi
    active_commits="$(grep -Eo '/vscode/vscode-server/bin/[^/]+/[0-9a-f]{40}' <<< "$process_list" \
      | sed -E 's@.*/@@' | sort -u || true)"
    while IFS= read -r commit; do
      [[ -n "$commit" ]] && protected_commits+=(--protect-commit "$commit")
    done <<< "$active_commits"
  done

  if [[ ! -r "$helper_script" ]]; then
    printf 'Skipping VS Code cache cleanup: helper script is unavailable.\n' >&2
    return 0
  fi
  if ! docker image inspect "$helper_image" >/dev/null 2>&1; then
    printf 'Pulling pinned VS Code cache helper image: %s\n' "$helper_image"
    if ! docker pull "$helper_image"; then
      printf 'Skipping VS Code cache cleanup: helper image could not be retrieved.\n' >&2
      return 0
    fi
  fi

  if [[ ! -d "$HOME/workspaces" ]]; then
    printf 'Skipping VS Code cache cleanup: workspace root is missing; cannot verify MCP pins.\n' >&2
    return 0
  fi
  local config_list
  config_list="$(find "$HOME/workspaces" -type f -path '*/.vscode/mcp.json' -print 2>/dev/null)" || {
    printf 'Skipping VS Code cache cleanup: MCP config discovery failed.\n' >&2
    return 0
  }
  while IFS= read -r config; do
    [[ -n "$config" ]] || continue
    if [[ ! -r "$config" ]]; then
      printf 'Skipping VS Code cache cleanup: MCP config is unreadable: %s\n' "$config" >&2
      return 0
    fi
    local referenced_commits
    referenced_commits="$(grep -Eho 'vscode-server/bin/[^/]+/[0-9a-f]{40}' "$config" 2>/dev/null | sed -E 's@.*/@@' || true)"
    while IFS= read -r commit; do
      [[ -n "$commit" ]] && protected_commits+=(--protect-commit "$commit")
    done <<< "$referenced_commits"
  done <<< "$config_list"

  docker run --rm --pull=never --network none --read-only --security-opt=no-new-privileges \
    --mount 'type=volume,source=vscode,target=/vscode' \
    --mount "type=bind,source=${helper_script},target=/prune.py,readonly" \
    "$helper_image" python3 /prune.py --root /vscode/vscode-server \
    --extension-cache-max-age-days {{ workstation_cleanup_vscode_extension_cache_max_age_days }} \
    --server-max-age-days {{ workstation_cleanup_vscode_server_max_age_days }} \
    --keep-latest {{ workstation_cleanup_vscode_server_keep_latest }} \
    --require-protected-commit --apply "${protected_commits[@]}" \
    || printf 'VS Code cache cleanup failed; continuing other workstation cleanup.\n' >&2
}

{% raw %}
# Remove containers that have been STOPPED for more than N days.
#
# Docker has no stop-time filter. `docker container prune --filter until=X`
# compares the container's CREATED time and never looks at State.FinishedAt
# (moby daemon/prune.go reads c.Created), so a container created weeks ago but
# stopped a minute ago still matched -- which is how cortex-backend-1 and
# cortex-garage-1 were removed on 2026-09-21. This evaluates FinishedAt instead.
prune_idle_containers() {
  local age_days="$1"
  local cutoff
  cutoff=$(date -d "-${age_days} days" +%s) || return 0

  local id finished epoch
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue

    finished=$(docker container inspect -f '{{.State.FinishedAt}}' "$id" 2>/dev/null) || continue
    case "$finished" in ''|0001-01-01T00:00:00Z) continue ;; esac   # never started

    epoch=$(date -d "$finished" +%s 2>/dev/null) || continue

    if (( epoch < cutoff )); then
      printf 'Removing container stopped %s (>%sd ago): %s\n' "$finished" "$age_days" "$id"
      docker container rm "$id" || printf 'Could not remove container %s\n' "$id" >&2
    fi
  done < <(docker container ls -aq --filter status=exited)
}
{% endraw %}

clean_old_files "$HOME/Downloads" {{ workstation_cleanup_downloads_max_age_days }}

clean_old_files "$HOME/.bun/install/cache" {{ workstation_cleanup_bun_cache_max_age_days }}
clean_old_files "$HOME/.cache/cargo-target" {{ workstation_cleanup_cargo_target_max_age_days }}
clean_old_files "$HOME/.cache/go-build" {{ workstation_cleanup_go_build_max_age_days }}
clean_old_files "$HOME/.cache/go/pkg/mod" {{ workstation_cleanup_go_mod_max_age_days }}

run_if_available uv uv cache prune
run_if_available direnv direnv prune
run_if_available nix-collect-garbage nix-collect-garbage --delete-older-than {{ nix_cleanup_generation_max_age_days }}d

# Docker -- containers age by how long they have been IDLE (State.FinishedAt)
# instead of when they were created. Docker has no stop-time filter, so the
# helper above handles containers. Image/network `until` filters use creation
# age; builder-cache `until` uses last-use age.
if command -v docker >/dev/null 2>&1; then
  prune_idle_containers {{ workstation_cleanup_docker_container_max_age_days }}
  prune_vscode_cache
  run_if_available docker docker image prune -af --filter "until={{ (workstation_cleanup_docker_image_max_age_days | int) * 24 }}h"
  run_if_available docker docker network prune -f --filter "until={{ (workstation_cleanup_docker_network_max_age_days | int) * 24 }}h"
  run_if_available docker docker builder prune -af --filter "until={{ (workstation_cleanup_docker_build_cache_max_age_days | int) * 24 }}h"
fi
# Flatpak -- clean unused runtimes from system installation (needs sudo)
run_if_available flatpak sudo flatpak uninstall --unused --noninteractive
# Systemd journal -- limit size on disk
run_if_available /usr/local/sbin/workstation-journal-vacuum sudo /usr/local/sbin/workstation-journal-vacuum
