---
extends: default
rules:
  line-length:
    max: 120
    level: error
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
ignore: |
  apm.lock.yaml
  apm_modules/
